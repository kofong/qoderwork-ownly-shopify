<section class="how-it-works section-padding">
  <div class="section-container">
    <div class="section-header reveal">
      {%- if section.settings.tag != blank -%}
        <span class="section-tag">{{ section.settings.tag }}</span>
      {%- endif -%}
      <h2 class="section-header__title">{{ section.settings.heading }}</h2>
      <p class="section-header__desc">{{ section.settings.description }}</p>
    </div>

    <div class="how-it-works__grid reveal-stagger">
      {%- for block in section.blocks -%}
        <div class="how-it-works__step" {{ block.shopify_attributes }}>
          <div class="how-it-works__circle">{{ block.settings.icon }}</div>
          <h4 class="how-it-works__title">{{ block.settings.number }}. {{ block.settings.title }}</h4>
          <p class="how-it-works__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .how-it-works__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    position: relative;
  }
  .how-it-works__grid::before {
    content: '';
    position: absolute;
    top: 36px;
    inset-inline-start: 12.5%;
    inset-inline-end: 12.5%;
    height: 2px;
    background: var(--color-border);
    z-index: 0;
  }
  .how-it-works__step {
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .how-it-works__circle {
    width: 72px;
    height: 72px;
    background: white;
    border: 3px solid var(--color-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 1rem;
  }
  .how-it-works__title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
  }
  .how-it-works__desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  @media (max-width: 768px) {
    .how-it-works__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .how-it-works__grid::before { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section tag",
      "default": "Simple Process"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From idea to doorstep in 4 easy steps. Most orders ship within 3-5 business days."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🎯" },
        { "type": "text", "id": "number", "label": "Step number", "default": "1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Choose Product" },
        { "type": "text", "id": "description", "label": "Description", "default": "Browse 50+ products" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "🎯", "number": "1", "title": "Choose Product", "description": "Browse our catalog of 50+ customizable products" } },
        { "type": "step", "settings": { "icon": "🎨", "number": "2", "title": "Design It", "description": "Upload your art or generate with AI" } },
        { "type": "step", "settings": { "icon": "👁️", "number": "3", "title": "Preview", "description": "See real-time mockups before you buy" } },
        { "type": "step", "settings": { "icon": "📦", "number": "4", "title": "We Ship", "description": "Produced on-demand and shipped to your door" } }
      ]
    }
  ]
}
{% endschema %}
