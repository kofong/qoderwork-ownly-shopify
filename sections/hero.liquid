<section class="hero{% if section.settings.hero_style == 'fullbleed' %} hero--fullbleed{% else %} section-padding{% endif %}"
  style="
    --hero-bg-start: {{ section.settings.bg_gradient_start }};
    --hero-bg-mid: {{ section.settings.bg_gradient_mid }};
    --hero-bg-end: {{ section.settings.bg_gradient_end }};
    --hero-overlay: {{ section.settings.overlay_color }};
    --hero-min-height: {{ section.settings.hero_height }}vh;
  "
>
  {%- if section.settings.hero_style == 'fullbleed' -%}
    <div class="hero__bg-media">
      {%- if section.settings.hero_video != blank -%}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hero__bg-video' }}
      {%- elsif section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1920 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.heading,
          class: 'hero__bg-image'
        }}
      {%- else -%}
        <div class="hero__bg-fallback"></div>
      {%- endif -%}
      <div class="hero__overlay"></div>
    </div>
  {%- endif -%}

  <div class="hero__inner section-container">
    <div class="hero__content">
      {%- if section.settings.badge_text != blank -%}
        <span class="hero__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}

      <h1 class="hero__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_highlight != blank -%}
          <span class="hero__heading-highlight">{{ section.settings.heading_highlight }}</span>
        {%- endif -%}
      </h1>

      <p class="hero__description">{{ section.settings.description }}</p>

      <div class="hero__actions">
        <a href="{{ section.settings.cta_primary_url | default: routes.all_products_collection_url }}" class="btn btn--primary">
          {{ section.settings.cta_primary_text }}
        </a>
        {%- if section.settings.show_ai_cta -%}
          <a href="{{ section.settings.cta_ai_url }}" class="btn btn--ai">
            {{ section.settings.cta_ai_text }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.hero_style == 'split' -%}
      <div class="hero__visual">
        <div class="hero__mockup">
          {%- if section.settings.hero_image != blank -%}
            {{ section.settings.hero_image | image_url: width: 600 | image_tag:
              loading: 'eager',
              alt: section.settings.heading,
              width: section.settings.hero_image.width,
              height: section.settings.hero_image.height
            }}
          {%- else -%}
            <div class="hero__placeholder">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-secondary)" stroke-width="1"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
          {%- endif -%}
          <p class="hero__mockup-label">{{ section.settings.mockup_label }}</p>
        </div>

        <div class="hero__float hero__float--1">{{ section.settings.float_text_1 }}</div>
        <div class="hero__float hero__float--2">{{ section.settings.float_text_2 }}</div>
        <div class="hero__float hero__float--3">{{ section.settings.float_text_3 }}</div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.hero_style == 'fullbleed' and section.settings.show_scroll_indicator -%}
    <div class="hero__scroll-indicator">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ========== Split mode (default) ========== */
  .hero {
    background: linear-gradient(135deg, var(--hero-bg-start) 0%, var(--hero-bg-mid) 50%, var(--hero-bg-end) 100%);
    position: relative;
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.75rem;
    align-items: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .hero__heading {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 1.25rem;
  }
  .hero__heading-highlight { color: var(--color-accent); }
  .hero__description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    max-width: 480px;
    line-height: 1.7;
  }
  .hero__actions { display: flex; gap: 0.875rem; flex-wrap: wrap; }
  .hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero__mockup {
    width: 420px;
    height: 420px;
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    overflow: hidden;
  }
  .hero__mockup img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__mockup-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    padding-bottom: 1rem;
  }
  .hero__float {
    position: absolute;
    background: white;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    padding: 10px 16px;
    font-size: 0.8125rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    animation: hero-float 3s ease-in-out infinite;
  }
  .hero__float--1 { top: 20px; inset-inline-end: -20px; animation-delay: 0s; }
  .hero__float--2 { bottom: 40px; inset-inline-start: -30px; animation-delay: 1s; }
  .hero__float--3 { bottom: 100px; inset-inline-end: -40px; animation-delay: 2s; }
  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @media (max-width: 1024px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { display: none; }
  }

  /* ========== Fullbleed mode ========== */
  .hero--fullbleed {
    position: relative;
    min-height: var(--hero-min-height, 85vh);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    padding: 0;
  }

  .hero--fullbleed .hero__inner {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
    position: relative;
    z-index: 2;
    width: 100%;
    padding: clamp(4rem, 10vh, 8rem) clamp(1.25rem, 4vw, 3rem);
  }

  .hero--fullbleed .hero__content {
    max-width: 800px;
  }

  /* Fullbleed badge: semi-transparent white pill */
  .hero--fullbleed .hero__badge {
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    color: white;
    border: 1px solid rgba(255,255,255,0.2);
    font-size: 0.875rem;
    padding: 8px 18px;
    letter-spacing: 0.5px;
  }

  /* Fullbleed heading: MUCH bigger */
  .hero--fullbleed .hero__heading {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    color: white;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 40px rgba(0,0,0,0.3);
  }

  .hero--fullbleed .hero__heading-highlight {
    color: var(--color-accent);
    text-shadow: none;
  }

  /* Fullbleed description */
  .hero--fullbleed .hero__description {
    color: rgba(255,255,255,0.9);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    line-height: 1.7;
    text-shadow: 0 1px 10px rgba(0,0,0,0.2);
  }

  /* Fullbleed buttons: larger, pill-shaped */
  .hero--fullbleed .hero__actions {
    justify-content: center;
    gap: 1rem;
  }

  .hero--fullbleed .btn {
    padding: 16px 36px;
    font-size: 1rem;
    border-radius: 50px;
    font-weight: 600;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  }

  .hero--fullbleed .btn--primary {
    background: white;
    color: var(--color-primary);
  }

  .hero--fullbleed .btn--primary:hover {
    background: rgba(255,255,255,0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(0,0,0,0.3);
  }

  .hero--fullbleed .btn--ai {
    background: transparent;
    color: white;
    border: 2px solid rgba(255,255,255,0.5);
    box-shadow: none;
  }

  .hero--fullbleed .btn--ai:hover {
    background: rgba(255,255,255,0.1);
    border-color: white;
    transform: translateY(-2px);
  }

  .hero--fullbleed .hero__visual {
    display: none;
  }

  /* Background media layer */
  .hero__bg-media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero__bg-image,
  .hero__bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Gradient overlay: top-transparent to bottom-dark */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
  }

  /* Fallback gradient when no image is set */
  .hero__bg-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1A1A2E 0%, #2D1B4E 50%, #1A1A2E 100%);
  }

  /* Scroll indicator */
  .hero__scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    opacity: 0.6;
    animation: hero-scroll-bounce 2s ease-in-out infinite;
  }

  @keyframes hero-scroll-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (max-width: 768px) {
    .hero--fullbleed .hero__heading {
      font-size: clamp(2.25rem, 8vw, 3.5rem);
      letter-spacing: -1px;
    }
    .hero--fullbleed .hero__description {
      font-size: 1rem;
    }
    .hero--fullbleed .btn {
      padding: 14px 28px;
      font-size: 0.9375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "hero_style",
      "label": "Layout style",
      "options": [
        { "value": "split", "label": "Split (text + image side by side)" },
        { "value": "fullbleed", "label": "Full-bleed (image as background)" }
      ],
      "default": "fullbleed"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height (vh)",
      "min": 60,
      "max": 100,
      "step": 5,
      "default": 85,
      "unit": "vh"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Background video (full-bleed only)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color (full-bleed)",
      "alpha": true,
      "default": "#00000066"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll-down indicator",
      "default": true
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "AI-Powered Customization"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Upload once,"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight (accent color)",
      "default": "own everything."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Custom T-shirts, AirPods cases, mugs, tote bags, stickers and more. Upload your logo or let AI design it — we produce the whole package."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "checkbox",
      "id": "show_ai_cta",
      "label": "Show AI Designer button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_ai_text",
      "label": "AI button text",
      "default": "Try AI Designer"
    },
    {
      "type": "url",
      "id": "cta_ai_url",
      "label": "AI button link"
    },
    {
      "type": "header",
      "content": "Split mode only"
    },
    {
      "type": "text",
      "id": "mockup_label",
      "label": "Mockup label",
      "default": "Your design goes here"
    },
    {
      "type": "text",
      "id": "float_text_1",
      "label": "Floating badge 1",
      "default": "No minimum order"
    },
    {
      "type": "text",
      "id": "float_text_2",
      "label": "Floating badge 2",
