<section class="b2b section-padding">
  <div class="b2b__inner section-container">
    <div class="b2b__content reveal">
      <h2 class="b2b__heading">{{ section.settings.heading }}</h2>
      <p class="b2b__description">{{ section.settings.description }}</p>

      <div class="b2b__features">
        {%- for block in section.blocks -%}
          <div class="b2b__feature" {{ block.shopify_attributes }}>
            <div class="b2b__feature-icon">{{ block.settings.icon }}</div>
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>

      <a href="{{ section.settings.cta_url | default: 'mailto:sales@ownly.shop' }}" class="btn btn--primary">
        {{ section.settings.cta_text }}
      </a>
    </div>

    <div class="b2b__stats">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="b2b__stat" {{ block.shopify_attributes }}>
            <div class="b2b__stat-num">{{ block.settings.number }}</div>
            <div class="b2b__stat-label">{{ block.settings.label }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .b2b {
    background: var(--color-primary);
    color: white;
  }
  .b2b__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.75rem;
    align-items: center;
  }
  .b2b__heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }
  .b2b__description {
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.75rem;
    line-height: 1.7;
  }
  .b2b__features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .b2b__feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }
  .b2b__feature-icon {
    width: 32px;
    height: 32px;
    background: rgba(255,107,53,0.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .b2b__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .b2b__stat {
    background: rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .b2b__stat-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }
  .b2b__stat-label {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
  }
  @media (max-width: 1024px) {
    .b2b__inner { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "B2B section",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Custom Merch for Your Business"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Whether you need 10 branded polos or 500 event T-shirts, we handle everything from design to delivery. Volume discounts up to 40%."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Get a Bulk Quote"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "💰" },
        { "type": "text", "id": "text", "label": "Text", "default": "Volume pricing" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "40%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Max Bulk Discount" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B2B section",
      "blocks": [
        { "type": "feature", "settings": { "icon": "💰", "text": "Volume pricing — bigger orders, bigger savings" } },
        { "type": "feature", "settings": { "icon": "🎨", "text": "Free design assistance for orders 50+" } },
        { "type": "feature", "settings": { "icon": "📦", "text": "Bulk shipping & individual packaging options" } },
        { "type": "feature", "settings": { "icon": "⏱️", "text": "Rush orders available — as fast as 48 hours" } },
        { "type": "stat", "settings": { "number": "40%", "label": "Max Bulk Discount" } },
        { "type": "stat", "settings": { "number": "48h", "label": "Rush Order" } },
        { "type": "stat", "settings": { "number": "50+", "label": "Product Types" } },
        { "type": "stat", "settings": { "number": "1pc", "label": "Minimum Order" } }
      ]
    }
  ]
}
{% endschema %}
